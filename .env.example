# Copy to .env.local for local development. All variables are optional locally.

# Key for the opaque /api/image/<token> URLs.
# REQUIRED on Vercel (or any host running more than one instance): without it each
# instance generates its own random key and preview images fail intermittently.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LPS_SECRET=

# Mobile screenshot worker (see README). Leave unset locally to use the worker on 127.0.0.1:4410.
# On Vercel the worker isn't available, so capture is switched off automatically.
# CAPTURE_WORKER_URL=off
# CAPTURE_WORKER_TOKEN=

# Outbound fetch concurrency per process (default 8).
# LPS_MAX_CONCURRENT_FETCHES=8
